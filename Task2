import java.util.Scanner;

public class TileCost {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter room length: ");

        int length = scanner.nextInt();

        System.out.print("Enter room width: ");

        int width = scanner.nextInt();

        System.out.print("Enter tile price (floating-point): ");

        double price = scanner.nextDouble();

        int area = length * width;

        double totalAreaWithWaste = area * 1.05; // Adding 5% extra tiles

        double totalCost = totalAreaWithWaste * price;

        System.out.println("Total amount of money required: " + totalCost);

        scanner.close();

    }

}
